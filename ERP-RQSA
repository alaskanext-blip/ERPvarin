// --- UTILIDADES ---
const formatCurrency = (value) => {
  if (isNaN(value) || value === null || value === undefined) return '$0';
  return new Intl.NumberFormat('es-CL', { 
    style: 'currency', 
    currency: 'CLP',
    maximumFractionDigits: 0
  }).format(value);
};

const formatNumber = (value) => {
  if (isNaN(value) || value === null || value === undefined) return '0';
  return new Intl.NumberFormat('es-CL').format(value);
};

const formatCompactCurrency = (value) => {
  if (value >= 1000000) return `$${(value / 1000000).toFixed(1)}M`;
  if (value >= 1000) return `$${(value / 1000).toFixed(0)}k`;
  return `$${value}`;
};

// Conversor robusto para números (limpia separadores de miles, signos de peso, etc.)
const parseNumeric = (val) => {
  if (val === null || val === undefined || val === '') return 0;
  if (typeof val === 'number') return val;
  
  let str = String(val).trim().replace(/[^0-9.,-]/g, '');
  const lastCommaIndex = str.lastIndexOf(',');
  const lastPointIndex = str.lastIndexOf('.');

  if (lastCommaIndex > -1 && lastPointIndex > -1) {
      if (lastCommaIndex > lastPointIndex) {
          str = str.replace(/\./g, '').replace(',', '.');
      } else {
          str = str.replace(/,/g, '');
      }
  } else if (lastCommaIndex > -1) {
      if (str.split(',').length > 2 || str.match(/,\d{3}$/)) {
          str = str.replace(/,/g, '');
      } else {
          str = str.replace(',', '.');
      }
  } else if (lastPointIndex > -1) {
      if (str.split('.').length > 2 || str.match(/\.\d{3}$/)) {
          str = str.replace(/\./g, '');
      }
  }

  const num = parseFloat(str);
  return isNaN(num) ? 0 : num;
};

// Parseador de fechas robusto
const parseDate = (dateStr) => {
  if (!dateStr) return null;
  let str = String(dateStr).trim();
  
  if (str.match(/^\d{4}-\d{2}-\d{2}/)) return new Date(str);
  
  const parts = str.split(/[-/]/);
  if (parts.length === 3) {
      if (parts[2].length === 4) {
          return new Date(`${parts[2]}-${parts[1]}-${parts[0]}T00:00:00`);
      }
  }
  const fallback = new Date(str);
  return isNaN(fallback.getTime()) ? null : fallback;
};

const parseCSV = (text) => {
  const lines = text.split('\n');
  if (lines.length < 2) return [];
  
  const headers = lines[0].split(',').map(h => h.trim().replace(/^"|"$/g, ''));
  const result = [];
  const regex = /,(?=(?:(?:[^"]*"){2})*[^"]*$)/;
  
  for (let i = 1; i < lines.length; i++) {
    const line = lines[i].trim();
    if (!line) continue;
    
    const values = line.split(regex).map(v => v.trim().replace(/^"|"$/g, ''));
    const obj = {};
    headers.forEach((h, index) => {
      obj[h] = values[index] || '';
    });
    
    // LECTURA ESTRICTA
    if (values[5] !== undefined) obj.NETO = values[5];
    if (values[6] !== undefined) obj['C/ IVA'] = values[6];

    // LECTURA DE RUEDAS: Lisa (Cols O y Q -> 14 y 16), Rampa (Cols P y R -> 15 y 17)
    obj['Ruedas Lisa'] = parseNumeric(values[14]) + parseNumeric(values[16]);
    obj['Ruedas Rampa'] = parseNumeric(values[15]) + parseNumeric(values[17]);

    // Lectura estricta Columna M (Índice 12) para Regiones / RM
    if (values[12] !== undefined) obj['Reg / RM'] = values[12];

    if (!obj.Cliente && values[11] !== undefined) obj.Cliente = values[11];
    if (!obj.Tipo && values[9] !== undefined) obj.Tipo = values[9];
    if (!obj.FECHA && values[4] !== undefined) obj.FECHA = values[4];
    if (!obj['Nº'] && values[3] !== undefined) obj['Nº'] = values[3];
    if (!obj.Local && values[10] !== undefined) obj.Local = values[10];

    result.push(obj);
  }
  return result;
};

