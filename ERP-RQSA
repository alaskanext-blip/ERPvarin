// Gráfico Comparativo Mensual (SVG)
const ComparisonLineChart = ({ data, targetYear, divisor }) => {
  if (!data || data.length === 0) return null;

  // Calculamos valores maximos para escalar
  const maxVal = Math.max(...data.flatMap(d => [d.current, d.historical]), 1); 
  const width = 800;
  const height = 280;
  const padX = 40;
  const padYTop = 30;
  const padYBot = 30;
  const plotW = width - padX * 2;
  const plotH = height - padYTop - padYBot;

  const getX = (index) => padX + (index * (plotW / 11));
  const getY = (val) => padYTop + plotH - ((val / maxVal) * plotH);

  const pointsCurrent = data.map((d, i) => `${getX(i)},${getY(d.current)}`).join(' ');
  const pointsHistorical = data.map((d, i) => `${getX(i)},${getY(d.historical)}`).join(' ');

  return (
    <div className="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 flex flex-col h-full w-full">
       <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
          <div>
            <h3 className="text-lg font-bold text-slate-800">Tendencia Mensual: Año {targetYear} vs Histórico</h3>
            <p className="text-sm text-slate-500">Comparativa contra el promedio de los {divisor} años anteriores disponibles.</p>
          </div>
          <div className="flex items-center gap-4 text-xs font-semibold shrink-0 bg-slate-50 py-2 px-3 rounded-lg border border-slate-100">
             <div className="flex items-center gap-1.5 text-emerald-600">
                <span className="w-3 h-3 rounded-full bg-emerald-500"></span>
                Año {targetYear}
             </div>
             <div className="flex items-center gap-1.5 text-orange-500">
                <span className="w-3 h-0.5 border-b-2 border-dashed border-orange-400"></span>
                Promedio Histórico
             </div>
          </div>
       </div>
       
       <div className="relative w-full h-full min-h-[220px] mt-auto">
        <svg viewBox={`0 0 ${width} ${height}`} className="w-full h-full overflow-visible" preserveAspectRatio="none">
           {/* Grid lines y Etiquetas del Eje Y */}
           {[0, 0.25, 0.5, 0.75, 1].map((ratio, i) => {
             const y = padYTop + plotH * ratio;
             return (
               <g key={`grid-${i}`}>
                  <line x1={padX} y1={y} x2={width - padX} y2={y} stroke="#f1f5f9" strokeWidth="1.5" />
                  <text x={padX - 8} y={y + 4} fill="#94a3b8" fontSize="10" textAnchor="end">
                    {formatCompactCurrency((1 - ratio) * maxVal)}
                  </text>
               </g>
             )
           })}

           {/* Etiquetas del Eje X */}
           {data.map((d, i) => (
              <text key={`label-${i}`} x={getX(i)} y={height - 5} fill="#64748b" fontSize="11" textAnchor="middle" className="font-medium">
                  {d.label}
              </text>
           ))}

           {/* Línea Promedio Histórico */}
           <polyline fill="none" stroke="#f97316" strokeWidth="2.5" strokeDasharray="6,4" strokeLinecap="round" strokeLinejoin="round" points={pointsHistorical} />
           
           {/* Línea Año Actual */}
           <polyline fill="none" stroke="#10b981" strokeWidth="3.5" strokeLinecap="round" strokeLinejoin="round" points={pointsCurrent} />
           
           {/* Áreas Interactivas (Hover Tooltips) */}
           {data.map((d, i) => {
             const x = getX(i);
             const areaWidth = plotW / 11;
             return (
               <g key={`hover-${i}`} className="group">
                 {/* Banda invisible para activar el hover */}
                 <rect x={x - areaWidth/2} y={0} width={areaWidth} height={height - padYBot} fill="transparent" className="cursor-pointer" />
                 
                 {/* Línea vertical de resaltado */}
                 <line x1={x} y1={padYTop} x2={x} y2={padYTop + plotH} stroke="#cbd5e1" strokeWidth="1" strokeDasharray="3,3" className="opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none" />
                 
                 {/* Puntos en la curva */}
                 <circle cx={x} cy={getY(d.historical)} r="5" fill="#ffffff" stroke="#f97316" strokeWidth="2" className="opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none" />
                 <circle cx={x} cy={getY(d.current)} r="5" fill="#ffffff" stroke="#10b981" strokeWidth="2.5" className="opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none" />
                 
                 {/* Tooltip HTML insertado dentro de SVG */}
                 <foreignObject 
                    x={x > width/2 ? x - 150 : x + 15} 
                    y={Math.min(getY(d.current), getY(d.historical)) - 40 < padYTop ? padYTop : Math.min(getY(d.current), getY(d.historical)) - 40} 
                    width="140" 
                    height="85" 
                    className="opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"
                 >
                    <div className="bg-slate-800 text-white text-[11px] p-2.5 rounded-lg shadow-xl border border-slate-700">
                       <div className="font-bold text-slate-200 mb-1.5 border-b border-slate-600 pb-1">{d.label}</div>
                       <div className="flex justify-between items-center text-emerald-400 mb-1">
                          <span className="opacity-80 font-medium">Año {targetYear}:</span> 
                          <span className="font-bold">{formatCurrency(d.current)}</span>
                       </div>
                       <div className="flex justify-between items-center text-slate-300">
                          <span className="opacity-80 font-medium">Promedio:</span> 
                          <span className="font-bold">{formatCurrency(d.historical)}</span>
                       </div>
                    </div>
                 </foreignObject>
               </g>
             );
           })}
        </svg>
       </div>
    </div>
  );
};

// Gráfico de Anillo
const SVGDonutChart = ({ data, title }) => {
  if (!data || data.length === 0) return <div className="h-full flex items-center justify-center text-slate-400">Sin datos</div>;

  const total = data.reduce((acc, curr) => acc + curr.value, 0);
  const colors = ['#8b5cf6', '#10b981', '#f59e0b', '#ef4444', '#3b82f6'];
  let currentOffset = 0;
  
  return (
    <div className="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 flex flex-col h-full">
      <h3 className="text-lg font-bold text-slate-800 mb-6">{title}</h3>
      <div className="flex-1 flex items-center justify-center relative">
        <svg viewBox="0 0 100 100" className="w-48 h-48 transform -rotate-90 drop-shadow-sm">
          {data.map((item, index) => {
            const percentage = (item.value / total) * 100;
            const strokeDasharray = `${percentage} ${100 - percentage}`;
            const strokeDashoffset = -currentOffset;
            currentOffset += percentage;
            return (
              <circle
                key={index}
                cx="50"
                cy="50"
                r="31.83"
                fill="transparent"
                stroke={colors[index % colors.length]}
                strokeWidth="15"
                strokeDasharray={strokeDasharray}
                strokeDashoffset={strokeDashoffset}
                className="transition-all duration-1000 ease-out hover:stroke-width-[18px] cursor-pointer"
              />
            );
          })}
        </svg>
        <div className="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
          <span className="text-xs text-slate-400 uppercase font-bold">Total Neto</span>
          <span className="text-sm font-bold text-slate-800">
            {formatCompactCurrency(total)}
          </span>
        </div>
      </div>
      <div className="mt-6 flex flex-wrap justify-center gap-4">
        {data.map((item, index) => (
          <div key={index} className="flex items-center gap-2 text-xs">
            <span className="w-3 h-3 rounded-full" style={{ backgroundColor: colors[index % colors.length] }}></span>
            <span className="text-slate-600 font-medium">{item.label}</span>
            <span className="text-slate-400">({Math.round((item.value / total) * 100)}%)</span>
          </div>
        ))}
      </div>
    </div>
  );
};

// Gráfico de Barras Horizontales
const HorizontalBarChart = ({ data, title }) => {
  if (!data || data.length === 0) return <div className="h-full flex items-center justify-center text-slate-400">Sin datos</div>;
  const maxVal = Math.max(...data.map(d => d.value));

  return (
    <div className="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 flex flex-col h-full">
      <h3 className="text-lg font-bold text-slate-800 mb-6">{title}</h3>
      <div className="flex-1 flex flex-col justify-center gap-5 overflow-y-auto pr-2">
        {data.map((item, index) => {
          const widthPct = Math.max((item.value / maxVal) * 100, 2);
          return (
            <div key={index} className="w-full">
              <div className="flex justify-between text-sm mb-1.5">
                <span className="font-semibold text-slate-700 truncate pr-2">{item.label}</span>
                <span className="font-bold text-emerald-600">{formatCurrency(item.value)}</span>
