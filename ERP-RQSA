export default function App() {
  const [rawData, setRawData] = useState(() => {
    try {
      const saved = localStorage.getItem('facturacion_data');
      if (saved) return JSON.parse(saved);
    } catch (e) {
      console.warn("Error leyendo de memoria local", e);
    }
    return parseCSV(defaultCsvText).filter(r => r.FECHA || r['Nº']);
  });

  const [fileName, setFileName] = useState(() => {
    try {
      const savedName = localStorage.getItem('facturacion_filename');
      if (savedName) return savedName;
    } catch (e) {}
    return "Ejemplo Inicial";
  });

  const [errorMsg, setErrorMsg] = useState("");
  
  // Estados de Filtros
  const [searchTerm, setSearchTerm] = useState("");
  const [filterCliente, setFilterCliente] = useState("");
  const [filterTipo, setFilterTipo] = useState("");
  const [filterYear, setFilterYear] = useState(""); 
  
  // Nuevos filtros específicos de tabla
  const [filterFactura, setFilterFactura] = useState("");
  const [filterClienteLocal, setFilterClienteLocal] = useState("");
  
  const fileInputRef = useRef(null);

  const saveDataAndState = (data, name) => {
    setRawData(data);
    setFileName(name);
    try {
      localStorage.setItem('facturacion_data', JSON.stringify(data));
      localStorage.setItem('facturacion_filename', name);
    } catch (e) {
      console.warn("El archivo es demasiado grande para guardarse en la memoria caché del navegador.", e);
      setErrorMsg("Archivo cargado, pero es muy pesado para guardarse permanentemente. Si recargas, volverá al anterior.");
    }
  };

  const handleFileUpload = async (event) => {
    const file = event.target.files[0];
    if (!file) return;
    
    setErrorMsg("");
    clearFilters();

    if (file.name.toLowerCase().endsWith('.csv')) {
      const reader = new FileReader();
      reader.onload = (e) => {
        const parsed = parseCSV(e.target.result).filter(r => r.FECHA || r['Nº']);
        saveDataAndState(parsed, file.name);
      };
      reader.readAsText(file);
      return;
    }

    try {
      const XLSX = await import('https://cdn.sheetjs.com/xlsx-0.20.0/package/xlsx.mjs');
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const workbook = XLSX.read(new Uint8Array(e.target.result), { type: 'array' });
          const worksheet = workbook.Sheets[workbook.SheetNames[0]];
          const rawRows = XLSX.utils.sheet_to_json(worksheet, { header: 1, raw: false, defval: "" });
          
          if (rawRows.length > 1) {
            const headers = rawRows[0].map(h => String(h).trim());
            const normalizedData = [];
            
            for (let i = 1; i < rawRows.length; i++) {
               const row = rawRows[i];
               if (!row || row.length === 0) continue;
               
               const obj = {};
               headers.forEach((h, index) => {
                 obj[h] = row[index];
               });
               
               if (row[5] !== undefined) obj.NETO = row[5];
               if (row[6] !== undefined) obj['C/ IVA'] = row[6];
               obj['Ruedas Lisa'] = parseNumeric(row[14]) + parseNumeric(row[16]);
               obj['Ruedas Rampa'] = parseNumeric(row[15]) + parseNumeric(row[17]);
               
               if (row[12] !== undefined) obj['Reg / RM'] = row[12];
               if (!obj.Cliente && row[11] !== undefined) obj.Cliente = row[11];
               if (!obj.Tipo && row[9] !== undefined) obj.Tipo = row[9];
               if (!obj.FECHA && row[4] !== undefined) obj.FECHA = row[4];
               if (!obj['Nº'] && row[3] !== undefined) obj['Nº'] = row[3];
               if (!obj.Local && row[10] !== undefined) obj.Local = row[10];

               normalizedData.push(obj);
            }
            const finalData = normalizedData.filter(r => r.FECHA || r['Nº']);
            saveDataAndState(finalData, file.name);
          }
        } catch (err) {
          setErrorMsg("No se pudo procesar el formato de este Excel.");
        }
      };
      reader.readAsArrayBuffer(file);
    } catch (error) {
      setErrorMsg("Error cargando librería de Excel. Usa CSV.");
    }
  };

  const clearFilters = () => {
    setSearchTerm("");
    setFilterCliente("");
    setFilterTipo("");
    setFilterYear("");
    setFilterFactura("");
    setFilterClienteLocal("");
  };

  const uniqueClientes = useMemo(() => {
    return [...new Set(rawData.map(r => r.Cliente).filter(Boolean))].sort();
  }, [rawData]);

  const uniqueTipos = useMemo(() => {
    return [...new Set(rawData.map(r => r.Tipo).filter(Boolean))].sort();
  }, [rawData]);

  const uniqueYears = useMemo(() => {
    const years = new Set();
    rawData.forEach(row => {
      const dateObj = parseDate(row.FECHA);
      if (dateObj && !isNaN(dateObj.getFullYear())) {
        years.add(dateObj.getFullYear().toString());
      }
    });
    return [...years].sort((a, b) => b - a);
  }, [rawData]);

  // Procesamiento Analítico y Gráficos
  const { analytics, filteredData } = useMemo(() => {
    let totalNeto = 0;
    let totalRuedasLisa = 0;
    let totalRuedasRampa = 0;

    const regionMap = {}, tipoMap = {};
    const term = searchTerm.toLowerCase();

    // 1. Filtrado Base (Sin considerar el Año - Esto es clave para poder sacar el promedio de años anteriores)
    const baseFiltered = rawData.filter(row => {
      const matchesSearch = Object.values(row).some(val => String(val).toLowerCase().includes(term));
      const matchesCliente = filterCliente === "" || row.Cliente === filterCliente;
      const matchesTipo = filterTipo === "" || row.Tipo === filterTipo;
      const matchesFactura = filterFactura === "" || String(row['Nº'] || '').toLowerCase().includes(filterFactura.toLowerCase());
      const matchesClienteLocal = filterClienteLocal === "" || String(row.Cliente || '').toLowerCase().includes(filterClienteLocal.toLowerCase()) || String(row.Local || '').toLowerCase().includes(filterClienteLocal.toLowerCase());
      return matchesSearch && matchesCliente && matchesTipo && matchesFactura && matchesClienteLocal;
    });

    // 2. Filtrado Completo (Incluyendo el Año seleccionado, para KPIs y Tablas)
    const filtered = baseFiltered.filter(row => {
      if (filterYear === "") return true;
      const rowDate = parseDate(row.FECHA);
      return rowDate && rowDate.getFullYear().toString() === filterYear;
    });

    // Cálculos de KPIs basados en Filtros Completos
    filtered.forEach(row => {
      const neto = parseNumeric(row.NETO);
      const lisa = parseNumeric(row['Ruedas Lisa']);
      const rampa = parseNumeric(row['Ruedas Rampa']);

      let rawRegion = String(row['Reg / RM'] || '').trim();
      let region = 'Sin Asignar';
      
      if (rawRegion.toUpperCase() === 'RM') {
        region = 'RM';
      } else if (rawRegion.toUpperCase().includes('REGION') || rawRegion.toUpperCase() === 'REGIONES') {
        region = 'Regiones';
      } else if (rawRegion !== '') {
        region = rawRegion; 
      }

      const tipo = row.Tipo || 'Otros';

      totalNeto += neto;
      totalRuedasLisa += lisa;
      totalRuedasRampa += rampa;
      
      if(neto > 0) {
        regionMap[region] = (regionMap[region] || 0) + neto;
        tipoMap[tipo] = (tipoMap[tipo] || 0) + neto;
      }
    });

    const regionData = Object.keys(regionMap)
      .map(k => ({ label: k, value: regionMap[k] }))
      .sort((a, b) => b.value - a.value);

    const tipoData = Object.keys(tipoMap)
      .map(k => ({ label: k, value: tipoMap[k] }))
      .sort((a, b) => b.value - a.value)
      .slice(0, 6);

    const ticketPromedio = filtered.length > 0 ? totalNeto / filtered.length : 0;

    // 3. Cálculos para el Gráfico Comparativo Mensual (Basado en el filtro base)
    // Definimos qué año analizar: Si hay un año filtrado, usamos ese. Si dice "Todos", usamos el último año disponible en la base.
    const allYearsInBase = new Set();
    baseFiltered.forEach(r => {
        const d = parseDate(r.FECHA);
        if (d && !isNaN(d.getFullYear())) allYearsInBase.add(d.getFullYear());
    });
    
    const maxYear = allYearsInBase.size > 0 ? Math.max(...Array.from(allYearsInBase)) : new Date().getFullYear();
    const targetYear = filterYear !== "" ? parseInt(filterYear) : maxYear;

    // Verificamos de los 3 años anteriores, cuáles realmente existen en los datos para hacer un promedio justo
    let historicalYearsCount = 0;
    if (allYearsInBase.has(targetYear - 1)) historicalYearsCount++;
    if (allYearsInBase.has(targetYear - 2)) historicalYearsCount++;
    if (allYearsInBase.has(targetYear - 3)) historicalYearsCount++;
    
    const avgDivisor = historicalYearsCount > 0 ? historicalYearsCount : 1; // Prevenir dividir por 0

    const monthlyDataTemplate = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'].map(label => ({
      label, current: 0, histTotal: 0
    }));

    baseFiltered.forEach(row => {
      const rowDate = parseDate(row.FECHA);
      if (!rowDate) return;
      
      const year = rowDate.getFullYear();
      const month = rowDate.getMonth(); // 0 a 11
      const neto = parseNumeric(row.NETO);

      if (year === targetYear) {
          monthlyDataTemplate[month].current += neto;
      } else if (year >= targetYear - 3 && year <= targetYear - 1) {
          // Si el año es uno de los 3 previos, suma al histórico
          monthlyDataTemplate[month].histTotal += neto;
      }
    });

    const monthlyComparison = {
      data: monthlyDataTemplate.map(m => ({
        label: m.label,
        current: m.current,
        historical: m.histTotal / avgDivisor // Promediamos según la cantidad de años previos que realmente existen
      })),
      targetYear: targetYear,
      divisor: historicalYearsCount
    };

    return { 
      filteredData: filtered,
      analytics: { 
        totalNeto, 
        ticketPromedio, 
        facturas: filtered.length, 
        totalRuedasLisa,
        totalRuedasRampa,
        regionData, 
        tipoData,
        monthlyComparison
      } 
    };
  }, [rawData, searchTerm, filterCliente, filterTipo, filterYear, filterFactura, filterClienteLocal]);

  return (
    <div className="min-h-screen bg-slate-50 font-sans text-slate-800 flex flex-col">
      
      {/* NAVBAR SUPERIOR */}
      <nav className="bg-slate-900 text-white px-6 py-4 shadow-lg sticky top-0 z-50">
        <div className="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
          
          <div className="flex items-center gap-4">
            <div className="bg-white px-3 py-1.5 rounded-lg shadow-sm flex items-center justify-center">
              <img 
                src="https://rocateq.com/wp-content/themes/rocateq/img/logo.svg" 
                alt="Rocateq Logo" 
                className="h-7 object-contain"
              />
            </div>
            <div className="hidden sm:block border-l border-slate-700 pl-4">
              <h1 className="text-lg font-bold tracking-tight">Facturación<span className="text-emerald-400 font-light">360</span></h1>
              <p className="text-xs text-slate-400 mt-0.5">Panel de Inteligencia Comercial</p>
            </div>
          </div>

          <div className="flex items-center gap-4 w-full sm:w-auto">
            <div className="flex-1 bg-slate-800 rounded-lg px-3 py-2 flex items-center border border-slate-700">
              <FileSpreadsheet className="w-4 h-4 text-emerald-400 mr-2" />
              <span className="text-sm text-slate-300 truncate max-w-[150px]">{fileName}</span>
            </div>
            
            <input 
              type="file" 
              accept=".csv, .xls, .xlsx" 
              className="hidden" 
              ref={fileInputRef} 
              onChange={handleFileUpload} 
            />
            <button 
              onClick={() => fileInputRef.current.click()}
              className="flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg transition-colors shadow-sm font-medium text-sm whitespace-nowrap"
            >
              <Upload className="w-4 h-4" />
              <span>Importar Datos</span>
            </button>
          </div>
        </div>
      </nav>

      {/* CONTENIDO PRINCIPAL */}
      <main className="flex-1 max-w-7xl mx-auto w-full p-6 space-y-6">
        
        {errorMsg && (
          <div className="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl flex items-center gap-3 shadow-sm">
            <AlertCircle className="w-5 h-5" />
            <span className="font-medium">{errorMsg}</span>
          </div>
        )}

        {/* BARRA DE FILTROS */}
        <div className="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex flex-wrap lg:flex-nowrap gap-4 items-end z-10 relative">
           
           <div className="w-full sm:w-1/3 lg:w-1/4">
             <label className="text-xs font-semibold text-slate-500 mb-1 flex items-center gap-1"><Calendar className="w-3 h-3"/> Año</label>
             <select 
                value={filterYear} 
                onChange={(e) => setFilterYear(e.target.value)}
                className="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-700 focus:ring-2 focus:ring-emerald-500 outline-none"
             >
                <option value="">Todos los años</option>
                {uniqueYears.map(y => <option key={y} value={y}>{y}</option>)}
             </select>
           </div>

           <div className="w-full sm:w-1/3 lg:w-1/4">
             <label className="text-xs font-semibold text-slate-500 mb-1 flex items-center gap-1"><Filter className="w-3 h-3"/> Cliente</label>
             <select 
                value={filterCliente} 
                onChange={(e) => setFilterCliente(e.target.value)}
                className="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-700 focus:ring-2 focus:ring-emerald-500 outline-none"
             >
                <option value="">Todos los clientes</option>
                {uniqueClientes.map(c => <option key={c} value={c}>{c}</option>)}
             </select>
           </div>
           
           <div className="w-full sm:w-1/3 lg:w-1/4">
             <label className="text-xs font-semibold text-slate-500 mb-1 flex items-center gap-1"><Briefcase className="w-3 h-3"/> Tipo de Producto</label>
             <select 
                value={filterTipo} 
                onChange={(e) => setFilterTipo(e.target.value)}
                className="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-700 focus:ring-2 focus:ring-emerald-500 outline-none"
             >
                <option value="">Todos los tipos</option>
                {uniqueTipos.map(t => <option key={t} value={t}>{t}</option>)}
             </select>
           </div>

           <div className="w-full lg:w-auto flex items-end">
              <button 
                onClick={clearFilters}
                className="w-full lg:w-auto px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg text-sm font-semibold transition-colors flex items-center justify-center gap-2"
                title="Limpiar filtros"
              >
                <X className="w-4 h-4" />
                <span className="lg:hidden">Limpiar Filtros</span>
              </button>
           </div>
        </div>

        {/* KPIs SUPERIORES */}
        <div className="grid grid-cols-1 xl:grid-cols-4 gap-6">
          <div className="xl:col-span-3 grid grid-cols-1 md:grid-cols-3 gap-6">
            <KPIBlock title="Ingreso Neto" value={formatCurrency(analytics.totalNeto)} icon={TrendingUp} colorClass="bg-violet-600" />
            <KPIBlock title="Ticket Promedio" value={formatCurrency(analytics.ticketPromedio)} subtitle="Promedio por factura" icon={Tag} colorClass="bg-amber-500" />
            <KPIBlock title="Documentos" value={formatNumber(analytics.facturas)} subtitle="Registros procesados" icon={FileSpreadsheet} colorClass="bg-blue-500" />
          </div>
          <div className="xl:col-span-1 grid grid-cols-2 xl:grid-cols-1 gap-4">
            <SmallKPIBlock title="Ruedas Lisa" value={formatNumber(analytics.totalRuedasLisa)} subtitle="Columnas O + Q" icon={Disc} colorClass="bg-indigo-500" />
            <SmallKPIBlock title="Ruedas Rampa" value={formatNumber(analytics.totalRuedasRampa)} subtitle="Columnas P + R" icon={Circle} colorClass="bg-pink-500" />
          </div>
        </div>

        {/* NUEVO GRÁFICO COMPARATIVO (Ancho Completo) */}
        <div className="w-full h-auto">
           <ComparisonLineChart 
              data={analytics.monthlyComparison.data} 
              targetYear={analytics.monthlyComparison.targetYear} 
              divisor={analytics.monthlyComparison.divisor}
           />
        </div>

        {/* SECCIÓN DE GRÁFICOS DONUT / BARRAS */}
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 h-auto lg:h-96">
          <div className="lg:col-span-1 h-80 lg:h-full">
            <SVGDonutChart title="Distribución Geográfica (Neto)" data={analytics.regionData} />
          </div>
          <div className="lg:col-span-2 h-80 lg:h-full">
            <HorizontalBarChart title="Rendimiento por Tipo de Producto (Top 6)" data={analytics.tipoData} />
          </div>
        </div>

        {/* TABLA INTERACTIVA */}
        <div className="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden flex flex-col">
          <div className="p-6 border-b border-slate-100 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white">
            <div>
              <h3 className="text-xl font-bold text-slate-800 flex items-center gap-2">
                Base de Datos Operativa
                <span className="bg-slate-100 text-slate-600 py-0.5 px-2.5 rounded-full text-sm font-semibold">
                  {filteredData.length}
                </span>
              </h3>
            </div>
            
            <div className="flex w-full sm:w-auto gap-3">
              <div className="relative flex-1 sm:w-64">
                <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <Search className="h-4 w-4 text-slate-400" />
                </div>
                <input
                  type="text"
                  placeholder="Búsqueda rápida libre..."
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                  className="w-full pl-10 pr-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all"
                />
              </div>
            </div>
          </div>
          
          <div className="overflow-x-auto max-h-[500px]">
            <table className="w-full text-left border-collapse">
              <thead className="bg-slate-50 sticky top-0 z-10 shadow-sm backdrop-blur-sm bg-opacity-90">
                <tr className="text-slate-500 text-xs font-bold uppercase tracking-wider">
                  <th className="px-6 py-3 border-b border-slate-200 align-top">
                    <div className="mb-2">Factura</div>
                    <input 
                      type="text" 
                      placeholder="Buscar Nº..." 
                      value={filterFactura}
                      onChange={(e) => setFilterFactura(e.target.value)}
                      className="w-full px-2 py-1.5 bg-white border border-slate-200 rounded text-[10px] sm:text-xs font-normal normal-case text-slate-700 focus:outline-none focus:ring-1 focus:ring-emerald-500 placeholder-slate-300"
                    />
                  </th>
                  <th className="px-6 py-3 border-b border-slate-200 align-top">
                    <div className="mb-2 mt-1">Fecha</div>
                  </th>
                  <th className="px-6 py-3 border-b border-slate-200 align-top">
                    <div className="mb-2">Cliente / Local</div>
                    <input 
                      type="text" 
                      placeholder="Buscar Cliente/Local..." 
                      value={filterClienteLocal}
                      onChange={(e) => setFilterClienteLocal(e.target.value)}
                      className="w-full px-2 py-1.5 bg-white border border-slate-200 rounded text-[10px] sm:text-xs font-normal normal-case text-slate-700 focus:outline-none focus:ring-1 focus:ring-emerald-500 placeholder-slate-300"
                    />
                  </th>
                  <th className="px-6 py-3 border-b border-slate-200 align-top">
                    <div className="mb-2 mt-1">Zona</div>
                  </th>
                  <th className="px-6 py-3 border-b border-slate-200 align-top">
                    <div className="mb-2 mt-1">Tipo Producto</div>
                  </th>
                  <th className="px-6 py-3 border-b border-slate-200 text-right align-top">
                    <div className="mb-2 mt-1">Neto</div>
                  </th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-100">
                {filteredData.length > 0 ? (
                  filteredData.map((row, index) => (
                    <tr key={index} className="hover:bg-emerald-50/50 transition-colors group">
                      <td className="px-6 py-4 text-sm font-semibold text-slate-900">
                        #{row['Nº'] || 'S/N'}
                      </td>
                      <td className="px-6 py-4 text-sm text-slate-500 whitespace-nowrap">
                        {row.FECHA || '-'}
                      </td>
                      <td className="px-6 py-4">
                        <div className="text-sm font-bold text-slate-800">{row.Cliente || 'Sin Cliente'}</div>
                        <div className="text-xs text-slate-500 mt-0.5">{row.Local || '-'}</div>
                      </td>
                      <td className="px-6 py-4 text-sm">
                        <span className={`inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold ${
                          row['Reg / RM'] === 'RM' ? 'bg-indigo-100 text-indigo-700' : 
                          row['Reg / RM'] === 'Regiones' ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-600'
                        }`}>
                          <MapPin className="w-3 h-3" />
                          {row['Reg / RM'] || 'N/A'}
                        </span>
                      </td>
                      <td className="px-6 py-4 text-sm text-slate-600 font-medium">
                        {row.Tipo || '-'}
                      </td>
                      <td className="px-6 py-4 text-sm font-bold text-emerald-600 text-right">
                        {formatCurrency(parseNumeric(row.NETO))}
                      </td>
                    </tr>
                  ))
                ) : (
                  <tr>
                    <td colSpan="6" className="px-6 py-12 text-center text-slate-400">
                      <div className="flex flex-col items-center justify-center">
                        <Filter className="w-8 h-8 mb-3 opacity-20" />
                        <p>No se encontraron registros que coincidan con los filtros aplicados.</p>
                      </div>
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
        
      </main>
    </div>
  );
}
